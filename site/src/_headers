# Same bytes, two deliveries: corpus.bin (gzip, 369 KB, needs
# DecompressionStream) and corpus.b64.txt (base64 text/plain, 468 KB, which the
# edge compresses and every browser inflates transparently). app.js picks the
# cheap one when it can. See scripts/build-corpus.mjs for the measurements.
/corpus.bin
  Cache-Control: public, max-age=86400
/corpus.b64.txt
  Cache-Control: public, max-age=86400
